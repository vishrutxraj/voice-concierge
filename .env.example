# Copy to .env and fill in. The service boots and runs end-to-end with ALL of
# these blank — providers fall back to mocks. You only need keys for live speech.

ENV=dev                       # dev | demo | test  (demo switches TTS to bulbul:v3)
LOG_LEVEL=INFO

# --- Providers -------------------------------------------------------------
SARVAM_API_KEY=
GROQ_API_KEY=

ASR_PROVIDER=sarvam           # sarvam | groq | mock
TTS_PROVIDER=sarvam           # sarvam | piper | mock
LLM_PROVIDER=groq             # groq | mock

# --- Observability (optional mirror; local tracing always works) -----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Persistence -----------------------------------------------------------
# SQLite needs no service. Swap to postgres://... and nothing else changes.
CHECKPOINT_DSN=sqlite:///./data/checkpoints.db
CACHE_DIR=./data/cache

# --- Responsible AI --------------------------------------------------------
PII_REDACTION_ENABLED=true
PII_REDACT_BEFORE_LLM=true
GUARDRAILS_ENABLED=true
CONSENT_REQUIRED_FOR_PERSISTENCE=true
TRACE_RETENTION_HOURS=24

# --- Human-in-the-loop thresholds -----------------------------------------
MIN_INTENT_CONFIDENCE=0.55
SENTIMENT_ESCALATION_THRESHOLD=-0.45
MAX_UNRESOLVED_TURNS=4
ESCALATION_WEBHOOK_URL=
ORDER_ID_FUZZY_THRESHOLD=0.72
